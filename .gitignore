# ================
# 构建目录 (最常见)
# ================
# CMake
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
compile_commands.json
# 如果你使用 Ninja 或其他生成器，构建目录可能叫 build/, out/, etc.
build/
bld/
out/
dist/
# 自定义构建目录
*_build/
*_bld/
*_out/

# Make
Makefile
makefile
GNUmakefile
# Make 生成的依赖文件
*.d
*.dep

